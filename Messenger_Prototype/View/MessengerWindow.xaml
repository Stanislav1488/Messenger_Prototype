<Window x:Class="Messenger_Prototype.View.MessengerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Messenger_Prototype"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#FF181818">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button Height="40" Width="40" Margin="10"/>
                <TextBox Height="40" Width="230" Style="{StaticResource styleTextBox}" Tag="Поиск"/>
            </StackPanel>

            <ListBox Grid.Row="1" Background="#FF181818">
                <StackPanel Height="60" Width="285" Orientation ="Horizontal">
                    <Image Height="40" Width="40" Margin="10"/>
                    <Label Height="40" Content="Stan Debilov" HorizontalAlignment="Center" FontSize="16" FontFamily="Segoe UI" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
                <StackPanel Height="60" Width="285" Orientation ="Horizontal">
                    <Image Height="40" Width="40" Margin="10"/>
                    <Label Height="40" Content="Ya lybly linky malinky" HorizontalAlignment="Center" FontSize="16" FontFamily="Segoe UI" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
                <StackPanel Height="60" Width="285" Orientation ="Horizontal">
                    <Image Height="40" Width="40" Margin="10"/>
                    <Label Height="40" Content="Go seks" HorizontalAlignment="Center" FontSize="16" FontFamily="Segoe UI" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </ListBox>
        </Grid>

        <Grid Grid.Column="1" >
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#FF181818">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left">
                    <Label Height="30" Margin="10, 0" Content="Линка Малинка" HorizontalAlignment="Left" FontSize="16" FontFamily="Segoe UI" FontWeight="Bold" Foreground="White"/>
                    <Label Height="30" Margin="10, 0" Content="был(а) 10 минут назад" HorizontalAlignment="Left" FontSize="16" FontFamily="Segoe UI" FontWeight="Bold" Foreground="White"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Height="40" Width="40" Margin="10"/>
                    <Button Height="40" Width="40" Margin="10"/>
                    <Button Height="40" Width="40" Margin="10"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Background="#FF232323">
            </Grid>

            <Grid Grid.Row ="2" Background="#FF181818">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Height="40" Width="40" Margin="10"/>

                <TextBox Grid.Column="1" Height="40" Style="{StaticResource styleTextBox}" Tag="Cообщение..."/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Height="40" Width="40" Margin="10"/>
                    <Button Height="40" Width="40" Margin="0, 0, 10, 0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
